{
  "name": "RoboSapiens Adaptive Platform (NVIDIA GPU)",
  "dockerComposeFile": "../../docker/docker-compose.yaml",
  "service": "rapdevnvidia",
  "runServices": [
    "rapdevnvidia"
  ],
  "workspaceFolder": "/ws",
  "shutdownAction": "stopCompose",
  "containterUser": "devuser",
  "mounts": [
    "source=${localWorkspaceFolder}/,target=/ws,type=bind,consistency=cached"
  ],
  "postCreateCommand": "/bin/bash -c \"uv venv && uv pip install --link-mode=copy -r requirements.txt\"",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        }
      },
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-toolsai.vscode-jupyter-powertoys",
        "ms-python.python"
      ]
    }
  }
}